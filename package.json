{
  "name": "@vakao-ui/axios",
  "version": "0.0.2",
  "description": "开箱即用的 axios 封装库：内置后端信封解包、401 单例刷新、去重取消、统一错误",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && rollup -c rollup.config.js",
    "release": "node scripts/publish.js"
  },
  "keywords": [
    "axios",
    "http",
    "request",
    "wrapper",
    "typescript",
    "authentication",
    "refresh-token"
  ],
  "author": {
    "name": "Rouarn",
    "email": "woyuxiaji@foxmail.com",
    "url": "https://github.com/Rouarn"
  },
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.0.10",
    "rimraf": "^6.1.2",
    "rollup": "^4.57.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "axios": ">=1.0.0"
  }
}
